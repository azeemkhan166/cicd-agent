// Helper method to format month year from toDate
    private String formatMonthYear(String toDate) {
        try {
            DateTimeFormatter inputFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
            DateTimeFormatter outputFormatter = DateTimeFormatter.ofPattern("MMM-yyyy");

            LocalDate to = LocalDate.parse(toDate, inputFormatter);
            return to.format(outputFormatter);
        } catch (Exception e) {
            LOGGER.warn("Error formatting month year, using fallback", e);
            return "Jun-" + LocalDate.now().getYear();
        }
    }

// Helper method to calculate previous quarter dates
    private Map<String, String> getPreviousQuarterDates(String fromDate, String toDate) {
        Map<String, String> result = new HashMap<>();
        try {
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
            LocalDate currentFrom = LocalDate.parse(fromDate, formatter);
            LocalDate currentTo = LocalDate.parse(toDate, formatter);

            // Calculate previous quarter by subtracting 3 months
            LocalDate prevFrom = currentFrom.minusMonths(3);
            LocalDate prevTo = currentTo.minusMonths(3);

            result.put("prevFromDate", prevFrom.format(formatter));
            result.put("prevToDate", prevTo.format(formatter));

        } catch (Exception e) {
            LOGGER.warn("Error calculating previous quarter dates, using fallback", e);
            // Fallback: if current quarter is Q2 (Apr-Jun), previous is Q1 (Jan-Mar)
            int currentYear = LocalDate.now().getYear();
            result.put("prevFromDate", currentYear + "-01-01");
            result.put("prevToDate", currentYear + "-03-31");
        }
        return result;
    }

