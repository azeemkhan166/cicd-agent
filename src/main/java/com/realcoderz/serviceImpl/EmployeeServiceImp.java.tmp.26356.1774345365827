    private List<LinkedCaseInsensitiveMap> transformPayrollDataToBonusRegister(
            List<LinkedCaseInsensitiveMap> payrollData,
            List<LinkedCaseInsensitiveMap> empAllowances,
            List<LinkedCaseInsensitiveMap> otherAllowances,
            String fromDate, String toDate) {

        // Group data by employee_id
        Map<Long, List<LinkedCaseInsensitiveMap>> employeeDataMap = payrollData.stream()
                .collect(Collectors.groupingBy(
                        data -> Long.valueOf(data.get("employee_id").toString()),
                        LinkedHashMap::new,
                        Collectors.toList()
                ));

        List<LinkedCaseInsensitiveMap> bonusData = new ArrayList<>();

        // Define months array based on the date range
        String[] months = generateMonthsArray(fromDate, toDate);

        // Process each employee
        for (Map.Entry<Long, List<LinkedCaseInsensitiveMap>> entry : employeeDataMap.entrySet()) {
            Long employeeId = entry.getKey();
            List<LinkedCaseInsensitiveMap> employeeRecords = entry.getValue();

            LinkedCaseInsensitiveMap employee = new LinkedCaseInsensitiveMap();

            // Get basic employee info from first record
            LinkedCaseInsensitiveMap firstRecord = employeeRecords.get(0);
            employee.put("EMP_ID", firstRecord.get("employee_code"));
            employee.put("Employee", safeString(firstRecord.get("name")));
            employee.put("Status", "Active");
            employee.put("DOJ", formatDOJ(firstRecord.get("joining_date")));
            employee.put("Department", safeString(firstRecord.get("department_name")));
            employee.put("Employee_Code", safeString(firstRecord.get("employee_code")));
            employee.put("UAN", safeString(firstRecord.get("uan")));

            // Create a map for easy month-wise payroll data access
            Map<String, Map<String, Object>> payrollMonthDataMap = new HashMap<>();
            for (LinkedCaseInsensitiveMap record : employeeRecords) {
                int month = Integer.parseInt(safeString(record.get("pay_run_month")));
                int year = Integer.parseInt(safeString(record.get("pay_run_year")));
                String monthKey = getMonthKey(month, year);

                Map<String, Object> monthData = new HashMap<>();
                monthData.put("pay_days", record.get("working_day"));
                monthData.put("net_payable", record.get("net_payable"));
                monthData.put("salary", record.get("salary"));
                monthData.put("payable", record.get("payable"));

                payrollMonthDataMap.put(monthKey, monthData);
            }

            // Add monthly data for all months in the range
            for (String month : months) {
                String monthKey = month.replace("/", "_");
                Map<String, Object> payrollMonthData = payrollMonthDataMap.get(month);

                // Get pay days from payroll data
                double payDays = 0.0;
                if (payrollMonthData != null) {
                    payDays = getNumericValue(payrollMonthData.get("pay_days"));
                }
                employee.put(monthKey + "_PayDays", payDays);

                // Calculate monthly amount from allowances and other allowances
                double monthlyAmount = calculateMonthlyAmountForEmployeeMonth(
                        employeeId, month, empAllowances, otherAllowances);
                employee.put(monthKey + "_Amount", Math.round(monthlyAmount));
            }

            // Calculate totals including bonus payable and ExGratia
            calculateEmployeeTotals(employee, months);

            bonusData.add(employee);
        }

        return bonusData;
    }

    private double calculateMonthlyAmountForEmployeeMonth(Long employeeId, String monthYear,
            List<LinkedCaseInsensitiveMap> empAllowances,
            List<LinkedCaseInsensitiveMap> otherAllowances) {
        // Parse month and year from monthYear string (e.g., "Apr/2025")
        String[] parts = monthYear.split("/");
        String monthStr = parts[0];
        int year = Integer.parseInt(parts[1]);
        int month = getMonthNumber(monthStr);

        double monthlyAmount = 0.0;

        // Sum allowances for this employee and month
        for (LinkedCaseInsensitiveMap allowance : empAllowances) {
            Long allowanceEmpId = Long.parseLong(allowance.get("employee_id").toString());
            if (Objects.equals(employeeId, allowanceEmpId)) {
                int allowanceMonth = Integer.parseInt(allowance.get("month").toString());
                int allowanceYear = Integer.parseInt(allowance.get("year").toString());

                if (allowanceMonth == month && allowanceYear == year) {
                    monthlyAmount += getNumericValue(allowance.get("allowance_payable_amount"));
                }
            }
        }

        // Sum other allowances for this employee and month
        for (LinkedCaseInsensitiveMap other : otherAllowances) {
            Long otherEmpId = Long.parseLong(other.get("employee_id").toString());
            if (Objects.equals(employeeId, otherEmpId)) {
                int otherMonth = Integer.parseInt(other.get("month").toString());
                int otherYear = Integer.parseInt(other.get("year").toString());

                if (otherMonth == month && otherYear == year) {
                    monthlyAmount += getNumericValue(other.get("payable_amount"));
                }
            }
        }

        return monthlyAmount;
    }

    private void calculateEmployeeTotals(LinkedCaseInsensitiveMap employee, String[] months) {
        double totalDays = 0;
        double totalAmount = 0;

        // Calculate totals from monthly data
        for (String month : months) {
            String monthKey = month.replace("/", "_");

            Object payDaysObj = employee.get(monthKey + "_PayDays");
            Object amountObj = employee.get(monthKey + "_Amount");

            if (payDaysObj != null) {
                totalDays += getNumericValue(payDaysObj);
            }

            if (amountObj != null) {
                totalAmount += getNumericValue(amountObj);
            }
        }

        // Calculate bonus payable (8.33% of total amount)
        double bonusPayable = Math.round(totalAmount * 8.33 / 100);

        // Calculate ExGratia - if BonusPayable exceeds 21000, the exceeded amount goes to ExGratia
        double exGratia = 0.0;
        if (bonusPayable > 21000) {
            exGratia = bonusPayable - 21000;
            bonusPayable = 21000; // Cap the BonusPayable at 21000
        }

        // Put the calculated values
        employee.put("TotalDays", Math.round(totalDays));
        employee.put("TotalAmount", Math.round(totalAmount));
        employee.put("BonusPayable", bonusPayable);
        employee.put("ExGratia", exGratia);
        employee.put("Remarks", "");
    }

    private String[] generateMonthsArray(String fromDate, String toDate) {
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");
        LocalDate start = LocalDate.parse(fromDate, formatter).withDayOfMonth(1);
        LocalDate end = LocalDate.parse(toDate, formatter).withDayOfMonth(1);

        List<String> monthsList = new ArrayList<>();

        LocalDate current = start;
        while (!current.isAfter(end)) {
            String monthYear = getMonthAbbreviation(current.getMonthValue()) + "/" + current.getYear();
            monthsList.add(monthYear);
            current = current.plusMonths(1);
        }

        return monthsList.toArray(new String[0]);
    }

    private String getMonthKey(int month, int year) {
        return getMonthAbbreviation(month) + "/" + year;
    }

    private String getMonthAbbreviation(int month) {
        String[] monthAbbreviations = {
            "Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
        };
        return monthAbbreviations[month - 1];
    }

    private int getMonthNumber(String monthStr) {
        Map<String, Integer> monthMap = new HashMap<>();
        monthMap.put("Jan", 1);
        monthMap.put("Feb", 2);
        monthMap.put("Mar", 3);
        monthMap.put("Apr", 4);
        monthMap.put("May", 5);
        monthMap.put("Jun", 6);
        monthMap.put("Jul", 7);
        monthMap.put("Aug", 8);
        monthMap.put("Sep", 9);
        monthMap.put("Oct", 10);
        monthMap.put("Nov", 11);
        monthMap.put("Dec", 12);

        return monthMap.getOrDefault(monthStr, 1);
    }

    private String formatDOJ(Object dojObj) {
        if (dojObj == null) {
            return "";
        }

        try {
            String dojStr = dojObj.toString();
            LocalDate dojDate = LocalDate.parse(dojStr);
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");
            return dojDate.format(formatter);
        } catch (Exception e) {
            return dojObj.toString();
        }
    }

    private String safeString(Object obj) {
        return obj == null ? "" : obj.toString().trim();
    }

    private double getNumericValue(Object obj) {
        if (obj == null) {
            return 0.0;
        }
        try {
            return Double.parseDouble(obj.toString());
        } catch (NumberFormatException e) {
            return 0.0;
        }
    }

    @Override
    public Double calculateEmployeeLWF(String stateName, Double grossSalary, String empType, int selectedMonth) {
        Double[] lwfAmount = new Double[1];
        lwfAmount[0] = 0.0;
        LOGGER.info("calledled  calculateEmployeeLWF " + " " + stateName + " " + grossSalary + " " + " " + empType+" "+selectedMonth);
