                // resultMap = this.getSavedEmployeeStandardOfWorker(map, request);

            } else if (employeeType.equalsIgnoreCase("Intern")) {
                resultMap = this.getStandardDataOfEmployeeForIntern(data, request);
            } else if (employeeType.equalsIgnoreCase("Consultant") || employeeType.equalsIgnoreCase("Contract")) {

                resultMap = this.getStandardDataOfEmployeeForConsultantWhenUpdate(data, request);
            } else {

                if (map.containsKey("PayrollBasedOn") && map.get("PayrollBasedOn") != null && map.get("PayrollBasedOn").toString().equalsIgnoreCase("Basic Salary")) {
