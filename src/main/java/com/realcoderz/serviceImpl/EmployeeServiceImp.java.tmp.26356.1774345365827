    @Override
    public Map redirectFunctionOfStandard(String data, HttpServletRequest request) {
        Map resultMap = new HashMap();
        try {
            Map<String, Object> map = mapper.readValue(EncryptDecryptUtils.decrypt(data), LinkedCaseInsensitiveMap.class);
            String employeeType = map.containsKey("employee_Type") ? map.get("employee_Type").toString() : map.containsKey("employeeType") ? map.get("employeeType").toString() : null;
            String ordId = map.containsKey("orgIds") ? map.get("orgIds").toString() : map.containsKey("orgIds") ? map.get("orgIds").toString() : "";
            Map employeeTypeResponse = this.checkPreviousEmployeeType(employeeType, map);
            if (employeeTypeResponse.containsKey("status") && employeeTypeResponse.get("status").toString().equalsIgnoreCase("success")) {
                if (employeeType.equalsIgnoreCase("Worker")) {
                    // resultMap = this.getStandardOfWorkerWhenUpdate(map, request);
                    resultMap = this.getStandardDataOfEmployeeForWorker(data, request);
                    // resultMap=this.getStandardDataOfEmployeeForWorker(data, request);
                    //resultMap = this.getSavedEmployeeStandardOfWorker(map, request);

                } else if (employeeType.equalsIgnoreCase("Intern")) {
                    resultMap = this.getStandardDataOfEmployeeForIntern(data, request);
                } else if (employeeType.equalsIgnoreCase("Consultant") || employeeType.equalsIgnoreCase("Contract")) {

                    resultMap = this.getStandardDataOfEmployeeForConsultantWhenUpdate(data, request);
                } else {
                    // resultMap= this.getStandardOfEmployeeWhenUpdate(map, request);
                    if (map.containsKey("PayrollBasedOn") && map.get("PayrollBasedOn") != null && map.get("PayrollBasedOn").toString().equalsIgnoreCase("Basic Salary")) {

                        resultMap = this.getStandardOnTheBasicOfBasicSalary(data, request);
                    } else {
                        resultMap = this.getStandardDataOfEmployee(data, request);
                        //  resultMap = this.getSavedEmployeeStandard(map, request);

                    }
                }
            } else {
                resultMap = employeeTypeResponse;
            }
            
            resultMap.put("orgIds", ordId);
        } catch (Exception e) {
            e.printStackTrace();
            resultMap.put("status", "exception");
            resultMap.put("exception", e.getMessage());

        }
        return resultMap;
    }

    @Override
    public ResponseEntity<byte[]> getSalarySheetReport(Long organizationId, String empType, Long month, Long year) {

        try {
            List<String> allowanceColumns = new ArrayList<>();
            List<String> payableAllowanceColumns = new ArrayList<>();
            List<String> DeductionColumns = new ArrayList<>();

            List<LinkedCaseInsensitiveMap> isrunPayrollDone = runPayrollRepo.isRunPayrollSavedForSheet(organizationId, month, year, empType);
            System.out.println("getSalarySheetReport isrunPayrollDone ------------- " + isrunPayrollDone);
            if (isrunPayrollDone.isEmpty()) {
                return ResponseEntity
                        .status(HttpStatus.INTERNAL_SERVER_ERROR)
                        .body(("Run Payroll Not Done").getBytes());

            }

            List<Allowance> allowance = allowanceRepo.findApprovedAllowancesForSheet(organizationId, empType);

            allowance.stream().forEach(a -> {

                allowanceColumns.add("STD " + a.getAllowance_name());
                payableAllowanceColumns.add(a.getAllowance_name());
            });

            allowanceColumns.add("STD Other Allowance");
            payableAllowanceColumns.add("Other Allowance");
            payableAllowanceColumns.add("Gross Earned Salary");

            List<Deduction> deduction = deductionRepo.findApprovedDeductionsForSheet(organizationId, empType);

            deduction.stream().forEach(d -> {
                DeductionColumns.add(d.getDeduction_name());
            });

            DeductionColumns.add("Total Deductions");
            DeductionColumns.add("Take Home Salary");
            DeductionColumns.add("Month");
            DeductionColumns.add("Year");

            String[] headerData = {"S.No", "UAN Number", "Name", "Employee Type", "Employee Code", "Work Location", "Department", "A/c No", "IFSC Code", "Gross Salary"};

            String[] restColumnHeader = {"Total days in month", "W/O", "Holiday", "Present Days", "Leave", "LWP", "Total Payable days"};

            String[] combinedHeaderArray = new String[headerData.length + allowanceColumns.size() + restColumnHeader.length + payableAllowanceColumns.size() + DeductionColumns.size()];

            for (int i = 0; i < headerData.length; i++) {
                combinedHeaderArray[i] = headerData[i];
            }

            for (int i = 0; i < allowanceColumns.size(); i++) {
                combinedHeaderArray[headerData.length + i] = allowanceColumns.get(i);
            }

            for (int i = 0; i < restColumnHeader.length; i++) {
                combinedHeaderArray[headerData.length + allowanceColumns.size() + i] = restColumnHeader[i];
            }

            for (int i = 0; i < payableAllowanceColumns.size(); i++) {
                combinedHeaderArray[headerData.length + allowanceColumns.size() + restColumnHeader.length + i] = payableAllowanceColumns.get(i);
            }

            for (int i = 0; i < DeductionColumns.size(); i++) {
                combinedHeaderArray[headerData.length + allowanceColumns.size() + restColumnHeader.length + payableAllowanceColumns.size() + i] = DeductionColumns.get(i);
            }

            String[] rowData = new String[combinedHeaderArray.length - 1];
            System.arraycopy(combinedHeaderArray, 1, rowData, 0, rowData.length);

            List<LinkedCaseInsensitiveMap> getDeductionForSalarySheet = empDeductionRepo.getDeductionForSalarySheet(organizationId, month, year, empType);
            List<LinkedCaseInsensitiveMap> getAllowanceForSalarySheet = empAllowanceRepo.getAllowancesForSalarySheet(organizationId, month, year, empType);
            List<LinkedCaseInsensitiveMap> getOtherAllowances = otherAllowanceRepo.getOtherAllowancesForSalaryReport(organizationId, month, year);
            System.out.println("getSalarySheetReport getAllowanceForSalarySheet ------------- " + getAllowanceForSalarySheet);
            System.out.println("getSalarySheetReport getOtherAllowances ------------- " + getOtherAllowances);
            List<LinkedCaseInsensitiveMap> resultList = new ArrayList<>();

            isrunPayrollDone.stream().forEach(r -> {

                LinkedCaseInsensitiveMap Json = new LinkedCaseInsensitiveMap();

                Long eIds = Long.parseLong(r.get("employee_id").toString());

                Json.put("Gross Salary", r.get("salary"));
                Json.put("Name", r.get("name"));
                Json.put("Employee Code", r.get("employee_code"));
                Json.put("Total Payable days", r.get("working_day"));
                Json.put("Work Location", r.get("employee_work_location"));
                Json.put("Department", r.get("department_name"));
                Json.put("A/c No", r.get("bank_account"));
                Json.put("IFSC Code", r.get("ifsc"));
                Json.put("Month", r.get("pay_run_month"));
                Json.put("Year", r.get("pay_run_year"));
                Json.put("Total days in month", r.get("actual_day"));
                Json.put("W/O", r.get("week_off"));
                Json.put("Holiday", r.get("holidays"));
                Json.put("Present Days", r.get("present_day"));
                Json.put("Leave", r.get("approved_leave"));
                Json.put("LWP", r.get("lwp"));
                Json.put("UAN Number", r.get("uan"));
                Json.put("Employee Type", r.get("employee_type"));

                Double[] grossEarnedSalary = new Double[1];
                grossEarnedSalary[0] = 0.0;
                getAllowanceForSalarySheet.stream().forEach(a -> {

                    Long aemployeeId = Long.parseLong(a.get("employee_id").toString());

                    if (Objects.equals(eIds, aemployeeId)) {
                        Json.put("STD " + a.get("allowance_name"), a.get("allowance_amount"));
                        Json.put(a.get("allowance_name"), a.get("allowance_payable_amount"));
                        grossEarnedSalary[0] = grossEarnedSalary[0] + Double.parseDouble(a.get("allowance_payable_amount").toString());

                    }

                });

                getOtherAllowances.stream().forEach(oa -> {

                    Long oaEmployeeId = Long.parseLong(oa.get("employee_id").toString());

