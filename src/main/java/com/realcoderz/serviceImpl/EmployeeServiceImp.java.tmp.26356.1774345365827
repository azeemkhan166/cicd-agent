        Double subtotalofCurrentAllowance = getSavedEployeeAllwance.stream()
                .filter(allowance -> "Total".equalsIgnoreCase(allowance.get("allowance_name").toString()))
                .mapToDouble(allowance -> Double.parseDouble(allowance.get("allowance_payable_amount").toString()))
                .sum(); // Default value if not found

        paidAllowances.put("basicSalary", Math.round(Double.parseDouble(paidAllowances.get("basicSalary").toString()) + basicSalary));
        paidAllowances.put("hra", Math.round(Double.parseDouble(paidAllowances.get("hra").toString()) + hra));
        paidAllowances.put("subtotal", Math.round(Double.parseDouble(paidAllowances.get("subtotal").toString()) + subtotalofCurrentAllowance + otherValueForTax));

        List<LinkedCaseInsensitiveMap> investmentlist = this.investmentDeclarationCalculation(startDateYear, employee_id);
        Double totalInvestment = 0.0;
        Double taxableIncome = 0.0;
        Double subtotalValue = Double.parseDouble(paidAllowances.get("subtotal").toString());
        Map taxValue = new HashMap<>();

        if (investmentlist.size() > 0) {

            Double rent = empAllowanceRepo.getRentAmount(endDate, Long.parseLong(investmentlist.get(0).get("declaration_id").toString()));

            Map payload = new HashMap<>();

            payload.put("basic", paidAllowances.get("basicSalary"));
            payload.put("hra", paidAllowances.get("hra"));
            payload.put("totalRent", rent != null ? rent : 0);
            payload.put("metroandNonMetroKey", investmentlist.get(0).get("status"));
            payload.put("exemptions_sec_10_Total", investmentlist.get(0).get("total_allowances"));
            payload.put("homeLoanTotal", investmentlist.get(0).get("interest_on_housing_loan_before"));
            payload.put("otherSec", investmentlist.get(0).get("Other section(sec80d,sec80u,sec80g,sec80e,sec80dd,nps)"));
            payload.put("incomeFromPreviousEmployer", investmentlist.get(0).get("income_from_previous_employer"));

            Map totalInvestmentValue = taxserviceimple.employeeTotalInvestemt(payload);

            if (totalInvestmentValue.get("status") != null && totalInvestmentValue.get("status").toString().equalsIgnoreCase("success")) {
                totalInvestment = totalInvestmentValue.get("totalInvestment") != null ? Double.parseDouble(totalInvestmentValue.get("totalInvestment").toString()) : 0.0;
                Double previousEmployerTds = 0.0;
                String slabType = "NewTaxSlabKey";
                if (investmentlist.size() > 0) {
                    slabType = investmentlist.get(0).get("tax_slab_tpye") != null ? investmentlist.get(0).get("tax_slab_tpye").toString() : "NewTaxSlabKey";
                    previousEmployerTds = investmentlist.get(0).get("income_from_previous_employer") != null ? Double.parseDouble(investmentlist.get(0).get("income_from_previous_employer").toString()) : 0.0;
                }

                taxableIncome = subtotalValue - totalInvestment - 50000 + previousEmployerTds;

                hraSum = totalInvestmentValue.get("leastOfAboveExcepted") != null ? Double.parseDouble(totalInvestmentValue.get("leastOfAboveExcepted").toString()) : 0.0;
                taxValue = taxserviceimple.calucluteCommonTax(taxableIncome, slabType, startDateYear);
            }

        } else {
            taxableIncome = subtotalValue - 50000;
            taxValue = taxserviceimple.calucluteCommonTax(taxableIncome, "NewTaxSlabKey", startDateYear);
        }

        Double totalTaxSum = Double.parseDouble(taxValue.get("surcharge").toString()) + Double.parseDouble(taxValue.get("taxLiability").toString()) + Double.parseDouble(taxValue.get("educationCess").toString());

        int taxDeductionTillDate = runPayrollRepo.taxdeductedTillDate(employee_id, startYear, endYear);

        Double finalTax = totalTaxSum - taxDeductionTillDate;

        if (finalTax < 0) {
            finalTax = 0.0;
        }

        result.put("taxValue", finalTax);
        result.put("hraValue", Math.round(hraSum));

        return result;

    }

    public List<LinkedCaseInsensitiveMap> investmentDeclarationCalculation(int year, Long employee_id) {
        List<LinkedCaseInsensitiveMap> finalList = new ArrayList<>();
        try {

            finalList = empAllowanceRepo.getInvesmentDecleration(employee_id, year);
            finalList.stream().forEach(data -> {
                Double sec80d = data.get("sec80d") != null ? Double.parseDouble(data.get("sec80d").toString()) : 0;
                Double sec80dd = data.get("sec80dd") != null ? Double.parseDouble(data.get("sec80dd").toString()) : 0;
                Double sec80e = data.get("sec80e") != null ? Double.parseDouble(data.get("sec80e").toString()) : 0;
                Double sec80u = data.get("sec80u") != null ? Double.parseDouble(data.get("sec80u").toString()) : 0;
                Double sec80g = data.get("sec80g") != null ? Double.parseDouble(data.get("sec80g").toString()) : 0;
                Double national_pension_scheme = data.get("national_pension_scheme") != null ? Double.parseDouble(data.get("national_pension_scheme").toString()) : 0;
                national_pension_scheme = national_pension_scheme > 50000 ? 50000 : national_pension_scheme;
                if (data.get("sec80d_type") != null) {
                    if (data.get("sec80d_type").toString().equalsIgnoreCase("parent")) {
                        sec80d = sec80d > 50000 ? 50000 : sec80d;
                    } else {
                        sec80d = sec80d > 25000 ? 25000 : sec80d;
                    }
                }

                Double otherSections = sec80d + sec80dd + sec80e + sec80u + sec80g + national_pension_scheme;
                Double intrest = 0.0;
                //homeLoanTotal
                if (data.get("interest_on_housing_loan_before") != null) {
                    intrest = Double.parseDouble(data.get("interest_on_housing_loan_before").toString()) >= 200000 ? 200000 : Double.parseDouble(data.get("interest_on_housing_loan_before").toString());
                }

                //other section
                data.put("Other section(sec80d,sec80u,sec80g,sec80e,sec80dd,nps)", otherSections);
                data.put("Deduction u/s 16", 50000);
                // Double houseRent=data.get("total_rent")!=null?Double.parseDouble(data.get("total_rent").toString()):0;
                Double totalAllwoance = 0.0;

                //total allowance
                if (data.get("total_allowances") != null) {
                    totalAllwoance = Double.parseDouble(data.get("total_allowances").toString()) <= 150000.0 ? Double.parseDouble(data.get("total_allowances").toString()) : 150000;
                }
                Double previousIncome = data.get("income_from_previous_employer") != null ? Double.parseDouble(data.get("income_from_previous_employer").toString()) : 0;
                data.put("Deduction u/s 16", 50000);
                data.put("totalDeduction", otherSections + totalAllwoance + intrest + 50000 - previousIncome);
                data.put("tax_slab_tpye", data.get("tax_slab_tpye"));
                Double previousEmployerTds = data.get("tdsPreviousEmployer") != null ? Double.parseDouble(data.get("tdsPreviousEmployer").toString()) : 0;
                data.put("previousEmployerTds", previousEmployerTds);
            });
            List<LinkedCaseInsensitiveMap> employeeWithInvestMent = finalList;

            finalList = employeeWithInvestMent;

        } catch (Exception e) {
            e.printStackTrace();
        }
        return finalList;
    }

    public Map otherEarningCalculation(Double basic, Double gross, String leaveEncasementKey, Long YearForLeaveEnhancement, Double leaveBalance, Double standardDays) {

        Map result = new HashMap<>();

        /**
         * Leave Encasement Calculation
         *
         */
        List<Map<String, Object>> otherEncasementValues = new ArrayList<>();

        Double leaveEncasementValue = 0.0;
        Double totalSumOFOtherEarning = 0.0;
        if (leaveEncasementKey.equalsIgnoreCase("gross")) {
            leaveEncasementValue = (gross / standardDays) * leaveBalance;
        } else {
            leaveEncasementValue = (basic / standardDays) * leaveBalance;
        }

        Map<String, Object> encashmentValue = new LinkedCaseInsensitiveMap<>();
        encashmentValue.put("name", "Leave encashment (Days)");
        encashmentValue.put("days", leaveBalance);
        encashmentValue.put("amount", Math.round(leaveEncasementValue));
        otherEncasementValues.add(encashmentValue);

        /**
         * gratuity Calculation
         *
         */
        Double gratuityValue = 0.0;
        if (YearForLeaveEnhancement >= 5) {
            gratuityValue = ((basic / 26) * 15) * YearForLeaveEnhancement;
        }

        Map<String, Object> gratuityValue1 = new LinkedCaseInsensitiveMap<>();
        gratuityValue1.put("name", "Gratuity (Years)");
        gratuityValue1.put("days", YearForLeaveEnhancement);
        gratuityValue1.put("amount", Math.round(gratuityValue));
        otherEncasementValues.add(gratuityValue1);

        /**
         * incentive Calculation
         *
         */
        Map<String, Object> incentivesValue = new LinkedCaseInsensitiveMap<>();
        incentivesValue.put("name", "Incentives if any");
        incentivesValue.put("days", "");
        incentivesValue.put("amount", 0);
        otherEncasementValues.add(incentivesValue);

        /**
         * other Calculation
         *
         */
        Map<String, Object> othersValue = new LinkedCaseInsensitiveMap<>();
        othersValue.put("name", "Others");
        othersValue.put("days", "");
        othersValue.put("amount", 0);
        otherEncasementValues.add(othersValue);

        /**
         * Total Sum of Other Earning
         *
         */
        totalSumOFOtherEarning = leaveEncasementValue + gratuityValue;

        Map<String, Object> totalSum = new LinkedCaseInsensitiveMap<>();
        totalSum.put("name", "Total");
        totalSum.put("days", "");
        totalSum.put("amount", Math.round(totalSumOFOtherEarning));
        otherEncasementValues.add(totalSum);

        result.put("otherEarningValue", otherEncasementValues);

        result.put("totalSumOFOtherEarning", totalSumOFOtherEarning);

        return result;

    }

