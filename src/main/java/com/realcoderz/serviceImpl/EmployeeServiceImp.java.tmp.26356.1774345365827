    @Override
    public Map getStandardDataOfEmployeeForConsultantWhenUpdate(String data, HttpServletRequest request) {
        Map resultMap = new HashMap<>();
        List<Map> loopArrat = new ArrayList<>();
        Map finalValue1 = new HashMap();
        Map finalValue = new HashMap();

        try {
            LOGGER.info("getStandardDataOfEmployeeForConsultant called from EmployeeServiceImpl");
            List<Map> loopfordeduction = new ArrayList<>();
            Map<String, Object> map = mapper.readValue(EncryptDecryptUtils.decrypt(data), LinkedCaseInsensitiveMap.class);

            Double Gross = Double.parseDouble(map.get("grossSalary").toString());
            Long employeeId = Long.parseLong(map.get("emp_id").toString());
            List<Integer> groupIds = new ArrayList<>();
            if (map.get("groups") != null) {
                groupIds = (List<Integer>) map.get("groups");
            }

            Integer gradeId = map.get("gradeId") != null ? Integer.parseInt(map.get("gradeId").toString()) : 0;
            String employeeType = map.containsKey("employee_Type") ? map.get("employee_Type").toString() : map.containsKey("employeeType") ? map.get("employeeType").toString() : null;

            // code for TDS Percentage Change
            Double percentageChange = 0.0;
            Double percentageChangeTax = salalrybreakuprepo.getPercentage(Long.parseLong(map.get("emp_id").toString()), Long.parseLong(map.get("organization_id").toString()));

            Double percentages = percentageChangeTax != null ? percentageChangeTax : 10.0;

            if (map.get("percentageChange").toString().equals("")) {
                percentageChange = percentages;
            } else {
                percentageChange = Double.parseDouble(map.get("percentageChange").toString());
            }

            LinkedCaseInsensitiveMap sid = salalrybreakuprepo.maxSalaryBreaup(employeeId, Gross);
            if (sid != null) {
                resultMap.put("sid", sid.get("sid"));
                resultMap.put("modeofpayment", sid.get("modeofpayment") != null ? sid.get("modeofpayment") : "");
                resultMap.put("orgIds", sid.get("orgIds") != null ? sid.get("orgIds") : "");

            } else {
                resultMap.put("modeofpayment", "");
                resultMap.put("orgIds", "");
            }

            if (map.get("employee_Type").toString().equalsIgnoreCase("Contract")) {
                finalValue1.put("allowance_name", "Contractual Fees");
            } else {
                finalValue1.put("allowance_name", "Consultant Fees");
            }
            finalValue1.put("editable", false);
            finalValue1.put("allowance_amount", Gross);
            loopArrat.add(finalValue1);

            resultMap.put("finalAllowance", loopArrat);

            // end of TDS Percentage change code
            // Deduction Calculation
            List<LinkedHashMap> employeeDeductionFromUi = (List<LinkedHashMap>) map.get("finalDeduction");
            List<LinkedCaseInsensitiveMap> deductions = deductionRepo.findApprovedDeductionIncludingTemplate(Long.parseLong(map.get("organization_id").toString()), employeeType);
            Optional<LinkedHashMap> matchingDeduction = Optional.empty();
            finalValue.put("deduction_name", "TDS");
            finalValue.put("deduction_amount", Math.round(Math.round((Gross / 100) * percentageChange) * 100.00) / 100.00);
            loopfordeduction.add(finalValue);

            for (LinkedCaseInsensitiveMap d : deductions) {
                Map deductionValue = new HashMap();
                if (d.get("applicable_for") != null && d.get("applicable_for").toString().equalsIgnoreCase("Group")) {
                    for (Integer id : groupIds) {
                        if (Objects.equals(Integer.parseInt(d.get("applicablity_id").toString()), id)) {

                            deductionValue = this.calculateDeductions(d, Gross, Gross, matchingDeduction);
                            if (deductionValue != null && !deductionValue.isEmpty()) {
                                loopfordeduction.add(deductionValue);
                            }
                        }

                    }
                } else if (d.get("applicable_for") != null && d.get("applicable_for").toString().equalsIgnoreCase("Employee")) {
                    if (Objects.equals(Long.parseLong(d.get("employee_id").toString()), employeeId)) {

                        deductionValue = this.calculateDeductions(d, Gross, Gross, matchingDeduction);
                        if (deductionValue != null && !deductionValue.isEmpty()) {
                            loopfordeduction.add(deductionValue);
                        }

                    }

                } else if (d.get("applicable_for") != null && d.get("applicable_for").toString().equalsIgnoreCase("Grade")) {
                    if (Objects.equals(Integer.parseInt(d.get("applicablity_id").toString()), gradeId)) {

                        deductionValue = this.calculateDeductions(d, Gross, Gross, matchingDeduction);
                        if (deductionValue != null && !deductionValue.isEmpty()) {
                            loopfordeduction.add(deductionValue);
                        }
                    }
                } else {
                    if (employeeDeductionFromUi != null && !d.get("deduction_name").toString().equalsIgnoreCase("TDS")) {
                        matchingDeduction = employeeDeductionFromUi.stream()
                                .filter(all -> {
                                    String deductionIdStr = d.get("deduction_id") != null ? d.get("deduction_id").toString() : null;
                                    String allDeductionIdStr = all.get("deduction_id") != null ? all.get("deduction_id").toString() : null;

                                    if (deductionIdStr != null && allDeductionIdStr != null) {
                                        return Objects.equals(Long.parseLong(deductionIdStr), Long.parseLong(allDeductionIdStr));
                                    }
                                    return false; // or handle the case when one or both IDs are null
                                })
                                .findFirst();
                    }

                    deductionValue = this.calculateDeductions(d, Gross, Gross, matchingDeduction);
                    if (deductionValue != null && !deductionValue.isEmpty()) {
                        loopfordeduction.add(deductionValue);
                    }
                }

            }

            // end of Deduction Calculation
            double totalDeductionValue = 0;
            for (int i = 0; i < loopfordeduction.size(); i++) {

                totalDeductionValue += Double.parseDouble(loopfordeduction.get(i).get("deduction_amount").toString());
            }
            // gross ka 10% TDS

            resultMap.put("finalDeduction", loopfordeduction);
            resultMap.put("totalDeduction", totalDeductionValue);
            resultMap.put("totalEarning", Gross);
            resultMap.put("netAmount", Gross - totalDeductionValue);
            resultMap.put("percentageChange", percentageChange);
            resultMap.put("status", "success");

        } catch (Exception ex) {

            ex.printStackTrace();
            resultMap.put("status", "exception");
            resultMap.put("msg", ex.getMessage());
        }
        return resultMap;
    }

