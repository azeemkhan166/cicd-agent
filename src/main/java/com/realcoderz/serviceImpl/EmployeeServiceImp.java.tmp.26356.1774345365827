                        Json.put("STD " + oa.get("name"), oa.get("amount"));
                        Json.put(oa.get("name").toString(), oa.get("payable_amount"));
                        grossEarnedSalary[0] = grossEarnedSalary[0] + Double.parseDouble(oa.get("payable_amount").toString());
                    }

                });

                Json.put("Gross Earned Salary", Math.round(grossEarnedSalary[0]));

                Double[] totalDeduction = new Double[1];
                totalDeduction[0] = 0.0;
                getDeductionForSalarySheet.stream().forEach(d -> {

                    Long dEmployeeId = Long.parseLong(d.get("employee_id").toString());

                    if (Objects.equals(eIds, dEmployeeId)) {

