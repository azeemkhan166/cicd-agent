    public Map calculateEsic(LinkedCaseInsensitiveMap d, Double Gross, Double Basic, LinkedCaseInsensitiveMap epfFlag, String isEsic, Optional<LinkedHashMap> uiDeduction, List<Map> loopArrat, List<LinkedCaseInsensitiveMap> deductionsMapping) {
        Map finalValue = new HashMap();
        try {
            Double allowancesSum = 0.0;
            LinkedHashMap deduction = new LinkedHashMap();
            if (uiDeduction.isPresent()) {
                deduction = uiDeduction.get();
            }
            Set<Long> allowanceMapped = deductionsMapping.stream().filter(deductionMapping -> Objects.equals(Long.parseLong(deductionMapping.get("deduction_template_id").toString()), Long.parseLong(d.get("deduction_template_id").toString())))
                    .map(map -> Long.parseLong(map.get("allowance_id").toString())).collect(Collectors.toSet());

            if (!allowanceMapped.isEmpty() && !loopArrat.isEmpty()) {
                allowancesSum = loopArrat.stream()
                        .filter(allowance -> allowance.get("allowance_id") != null
                        && allowance.get("allowance_amount") != null
                        && allowanceMapped.contains(Long.parseLong(allowance.get("allowance_id").toString())))
                        .mapToDouble(allowance -> Double.parseDouble(allowance.get("allowance_amount").toString()))
                        .sum();
            }

            finalValue.put("deduction_name", "ESIC");
            finalValue.put("deduction_id", d.get("deduction_id"));
            finalValue.put("employer_percentage", d.get("employer_percentage"));
            finalValue.put("deduction_template_id", d.get("deduction_template_id"));
            finalValue.put("editable", d.get("editable") != null ? d.get("editable") : false);
            Double percentage = d.get("employee_percentage") != null ? Double.parseDouble(d.get("employee_percentage").toString()) : 0.0;
            if (Gross <= 21000.00 && epfFlag.get("esic") != null && epfFlag.get("esic").toString().equalsIgnoreCase("Yes")) {
                if (d.get("salary").toString().equalsIgnoreCase("Gross")) {
                    finalValue.put("esic_flag_condition", "Yes");
                    finalValue.put("deduction_amount", Math.round(Math.round(((Gross - allowancesSum) / 100) * percentage) * 100.00) / 100.00);

                    if (deduction.get("deduction_amount") != null && deduction.get("editable") != null && Boolean.parseBoolean(deduction.get("editable").toString()) == true) {
                        finalValue.put("deduction_amount", deduction.get("deduction_amount"));

                    }

                } else if (d.get("salary").toString().equalsIgnoreCase("Basic")) {
                    finalValue.put("esic_flag_condition", "Yes");
                    finalValue.put("deduction_amount", Math.round(Math.round((Basic / 100) * percentage) * 100.00) / 100.00);
                    if (deduction.get("deduction_amount") != null) {
                        finalValue.put("deduction_amount", deduction.get("deduction_amount"));
                    }
                }
            } else {

                if (epfFlag.get("esic") != null && epfFlag.get("esic").toString().equalsIgnoreCase("Yes")) {

                    if (isEsic.equalsIgnoreCase("Yes")) {
                        finalValue.put("esic_flag_condition", "Yes");
                        finalValue.put("deduction_amount", Math.round(Math.round(((Gross - allowancesSum) / 100) * percentage) * 100.00) / 100.00);

                        if (deduction.get("deduction_amount") != null && deduction.get("editable") != null && Boolean.parseBoolean(deduction.get("editable").toString()) == true) {
                            finalValue.put("deduction_amount", deduction.get("deduction_amount"));

                        }
                    } else {
                        finalValue.put("esic_flag_condition", "No");
                        finalValue.put("deduction_amount", 0);
                    }
                } else {
                    finalValue.put("esic_flag_condition", "No");
                    finalValue.put("deduction_amount", 0);

                }

            }

        } catch (Exception e) {
            e.printStackTrace();
        }
        LOGGER.info("output from calculateEsic()->" + finalValue.toString());
        return finalValue;

    }

