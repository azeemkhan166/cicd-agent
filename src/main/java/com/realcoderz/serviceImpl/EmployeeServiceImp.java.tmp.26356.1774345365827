            if (labourDeduction.size() <= 0) {
                lwfAmount[0] = 0.0;
            } else {

                labourDeduction.stream().forEach(data -> {
                    if (data.getStart() <= grossSalary && data.getEnd() >= grossSalary) {
                        if (data.getFrequencyOfDeduction().equalsIgnoreCase("Monthly")) {
                            if (data.getPercentageOfSalary() == null || data.getPercentageOfSalary() == 0.0) {
                                lwfAmount[0] = 0.0;
                            } else {

                                double deduction = this.calculateLWFDeduction(grossSalary, empType, data);

