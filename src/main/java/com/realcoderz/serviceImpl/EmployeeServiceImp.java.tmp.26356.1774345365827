    public List<String> findMissingKeys(LinkedCaseInsensitiveMap map, String[] keys) {
        List<String> missingKeys = new ArrayList<>();
        for (String key : keys) {
            if (!map.containsKey(key)) {
                missingKeys.add(key);
            }
        }
        return missingKeys;
    }

