    @Override
    public Map bulkBankDetailsService(List<AccountDetails> list) {
        Map resultMap = new HashMap<>();
        List<AccountDetails> actualList = new ArrayList<>();
        try {
            if (list != null && !list.isEmpty()) {
                List<AccountDetails> allBankDetailsByOrgId = employeerepo.getAllBankDetailsByOrgId(list.get(0).getOrganization_id());
                list.stream().forEach(e -> {

                    Optional<AccountDetails> findAny = allBankDetailsByOrgId.stream().filter(all -> e.getEmployeeid().equals(all.getEmployeeid())).findAny();

                    if (findAny != null && findAny.isPresent()) {
                        //update
                        AccountDetails accountDetails = findAny.get();
                        accountDetails.setBankaccount(e.getBankaccount());
                        accountDetails.setIfsc(e.getIfsc());
                        accountDetails.setBankname(e.getBankname());
                        actualList.add(accountDetails);
                    } else {
                        //create
                        actualList.add(e);
                    }

                });

                employeerepo.saveAll(actualList);
                resultMap.put("status", "success");
                resultMap.put("msg", "Saved successfully!");
            } else {
                resultMap.put("status", "error");
            }
        } catch (Exception ex) {
            ex.printStackTrace();
            resultMap.put("status", "exception");
            LOGGER.info("Problem in EmployeeServiceImpl -> bulkBankDetailsService() :: ", ex);
        }
        return resultMap;
    }

