    @Override
    public Map getStandardDataOfEmployee(String data, HttpServletRequest request) {

        Map resultMap = new HashMap<>();
        List<Map> loopArrat = new ArrayList<>();
        List<Map> loopfordeduction = new ArrayList<>();

        try {
            LOGGER.info("getStandardDataOfEmployee called from EmployeeServiceImpl");

            Map<String, Object> map = mapper.readValue(EncryptDecryptUtils.decrypt(data), LinkedCaseInsensitiveMap.class);
            String isEsic = map.get("isEsic") != null ? map.get("isEsic").toString().equalsIgnoreCase("Yes") ? "Yes" : "No" : "No";
            List<Integer> groupIds = (List<Integer>) map.get("groups");
            String employeeType = map.containsKey("employee_Type") ? map.get("employee_Type").toString() : map.containsKey("employeeType") ? map.get("employeeType").toString() : null;
            if (employeeType.equalsIgnoreCase("Worker")) {
                employeeType = "Worker";
            } else {
                employeeType = "Full time";
            }

            Double Basic = 0.0;
            Double da = 0.0;
            Double Gross = Double.parseDouble(map.get("grossSalary").toString());
            Double percentageChange = 0.0;
            Long employeeId = Long.parseLong(map.get("emp_id").toString());
            String voluntaryEPF = map.get("voluntaryEpf") != null ? map.get("voluntaryEpf").toString() : "No";
            Double voluntaryEpfPercentage = map.get("voluntaryEpfPercentage") != null ? Double.parseDouble(map.get("voluntaryEpfPercentage").toString()) : 0.0;

            /**
             * check the condition where Standard breakup is saved or not
             *
             *
             */
            Integer gradeId = map.get("gradeId") != null ? Integer.parseInt(map.get("gradeId").toString()) : 0;
            if (map.containsKey("view") && map.get("view") != null && Boolean.valueOf(map.get("view").toString())) {
                return this.getSavedStandardBasedOnBasicEmployee(map);
            }
            
            
            Long orgId=map.get("orgIds") !=null ? Long.parseLong(map.get("orgIds").toString()):null;

            LinkedCaseInsensitiveMap epfFlag=new LinkedCaseInsensitiveMap();
                       
            if(orgId !=null){
                epfFlag = orgRepo.getEPFOFMultipleOrganizatrion(orgId);
            }
            else{
             epfFlag = orgRepo.getEPFOFOrganizatrion(Long.parseLong(map.get("organization_id").toString()));
            } 
                      
            String joiningDateOfEmployee = map.get("joiningDate").toString();
            List<LinkedHashMap> employeeAllowancesFromUi = (List<LinkedHashMap>) map.get("finalAllowance");

            List<LinkedCaseInsensitiveMap> allowances = allowanceRepo.findApprovedAllowanceWithTemplate(Long.parseLong(map.get("organization_id").toString()), employeeType);

            Double basicSalary = 0.0;

            Map allowanceResponse = this.calculateAllowancesForGrossSalary(allowances, gradeId, employeeId, groupIds, employeeAllowancesFromUi, Gross);
            if (allowanceResponse.containsKey("status") && allowanceResponse.get("status").toString().equalsIgnoreCase("success")) {
                loopArrat = (List<Map>) allowanceResponse.get("finalAllowances");
                basicSalary = Double.parseDouble(allowanceResponse.get("basic").toString());
            }

            double daamount = 0;
            double ta = 0;
            Long overTimeAllowanceTempleteId = 0l;
            for (int i = 0; i < loopArrat.size(); i++) {
                if (loopArrat.get(i).get("allowance_amount") != null) {
                    ta += Double.parseDouble(loopArrat.get(i).get("allowance_amount").toString());
                    if (loopArrat.get(i).get("allowance_name").toString().equalsIgnoreCase("da") || loopArrat.get(i).get("allowance_name").toString().equalsIgnoreCase("Dearness Allowance")) {
                        daamount = Double.parseDouble(loopArrat.get(i).get("allowance_amount").toString());
                    }
                    if (loopArrat.get(i).get("allowance_name") != null && loopArrat.get(i).get("allowance_name").toString().equalsIgnoreCase("Overtime Allowance")) {
                        overTimeAllowanceTempleteId = Long.parseLong(loopArrat.get(i).get("allowance_template_id").toString());
                    }
                }

            }

            double otherAllowance = Math.round((Gross - ta) * 100.00) / 100.00;

            resultMap.put("status", "success");
            resultMap.put("basic", Basic);

            resultMap.put("OtherAllowances", Math.round(otherAllowance));

            resultMap.put("finalAllowance", loopArrat);
            resultMap.put("percentageChange", percentageChange);
            resultMap.put("modeofpayment", "");
            resultMap.put("orgIds", "");

            // for  deduction calculation
            List<LinkedCaseInsensitiveMap> deductions = deductionRepo.findApprovedDeductionIncludingTemplate(Long.parseLong(map.get("organization_id").toString()), employeeType);

            Set<Long> deductionId = new HashSet<>();
            deductions.stream().forEach(d -> {
                if (d.get("deduction_template_id") != null) {
                    deductionId.add(Long.parseLong(d.get("deduction_template_id").toString()));
                }
            });

            Double baiscDA = basicSalary + daamount;

            List<LinkedHashMap> employeeDeductionFromUi = (List<LinkedHashMap>) map.get("finalDeduction");
            Map deductionsResponse = this.calculateDeductionsForBasicSalary(deductions, basicSalary, daamount, Gross, epfFlag, isEsic, 0.0, groupIds, employeeId, gradeId, map, employeeDeductionFromUi, voluntaryEpfPercentage, voluntaryEPF, loopArrat, otherAllowance);
            System.out.println(".deductionsResponse 1077" + " " + deductionsResponse.toString());
            if (deductionsResponse.containsKey("status") && deductionsResponse.get("status").toString().equalsIgnoreCase("success")) {
                loopfordeduction = (List<Map>) deductionsResponse.get("finalDeductions");
                resultMap.put("bonus", deductionsResponse.get("bonusDeduction"));
                resultMap.put("variable", deductionsResponse.get("variableDeduction"));
                resultMap.put("gratuityDeduction", deductionsResponse.get("gratuityDeduction"));
                resultMap.put("finalDeduction", loopfordeduction);
                resultMap.put("epf_flag_condition", deductionsResponse.get("epf_flag_condition"));
                resultMap.put("esic_flag_condition", deductionsResponse.get("esic_flag_condition"));
                resultMap.put("epf", deductionsResponse.get("epf_flag_condition"));
                resultMap.put("isEsic", deductionsResponse.get("esic_flag_condition"));
                baiscDA = deductionsResponse.get("basicDa") != null ? Double.parseDouble(deductionsResponse.get("basicDa").toString()) : baiscDA;

                // resu
            }

            double td = 0;

            for (int i = 0; i < loopfordeduction.size(); i++) {
                if (loopfordeduction.get(i).get("deduction_amount") != null) {
                    td += Double.parseDouble(loopfordeduction.get(i).get("deduction_amount").toString());

                }
            }

            /**
             * rate of Overtime Calculation
             *
             */
            Double rateOfOvertime = this.getRateOfOvertimeOfFullTime(overTimeAllowanceTempleteId, loopArrat);
            resultMap.put("rate", rateOfOvertime);

            resultMap.put("totalDeduction", td);
            resultMap.put("totalEarning", Gross);
            resultMap.put("netAmount", Gross - td);
            resultMap.put("baiscDA", baiscDA);
            resultMap.put("basic", basicSalary);
            resultMap.put("grossOFPayrollBasedOnBasic", Gross);
            resultMap.put("CalculationOnRunTime", "yes");

        } catch (Exception ex) {

            ex.printStackTrace();
            resultMap.put("status", "exception");
            resultMap.put("msg", ex.getMessage());
        }

        return resultMap;

    }

