            LOGGER.info("getSalaryHoldEmployee called from EmployeeServiceImpl");
            Map map = mapper.readValue(EncryptDecryptUtils.decrypt(data), LinkedCaseInsensitiveMap.class);

            /**
             * Fetching Employee Whose RunPayroll is Done
             *
             */
            List<LinkedCaseInsensitiveMap> employeeWhoseRunPayrollDone = runPayrollRepo.findAllSavedDataByMonthYearOfEmployee(Integer.parseInt(map.get("month").toString()), Integer.parseInt(map.get("year").toString()), Long.parseLong(map.get("organization_id").toString()), searchWord);

            /**
             * Fetching Employee Whose Salary On Hold
             *
             */
            List<LinkedCaseInsensitiveMap> employeeWhoseSalaryOnHold = employeerepo.getAllEmployeeWhoseSalaryOnHold(Long.parseLong(map.get("organization_id").toString()));

            /**
             * Removing Employee Whose Payroll is Done on particular month
             *
             */
            if (employeeWhoseSalaryOnHold.size() > 0 && employeeWhoseRunPayrollDone.size() > 0) {
