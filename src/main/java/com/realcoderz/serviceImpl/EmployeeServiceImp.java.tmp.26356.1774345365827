                            }
                        } else if (data.getFrequencyOfDeduction().equalsIgnoreCase("Half yearly")) {

                            if (selectedMonth == 6 || selectedMonth == 12) {
                                if (data.getPercentageOfSalary() == null || data.getPercentageOfSalary() == 0.0) {
                                    lwfAmount[0] = data.getEmployeeDeduction();
                                } else {

                                    double deduction = this.calculateLWFDeduction(grossSalary, empType, data);
                                    lwfAmount[0] = deduction;
                                }
                            } else {
                                lwfAmount[0] = 0.0;
                            }
                        } else if (data.getFrequencyOfDeduction().equalsIgnoreCase("Quaterly")) {
                            if (selectedMonth == 6 || selectedMonth == 9 || selectedMonth == 12 || selectedMonth == 3) {
                                if (data.getPercentageOfSalary() == null || data.getPercentageOfSalary() == 0.0) {
                                    lwfAmount[0] = data.getEmployeeDeduction();
                                } else {

                                    double deduction = this.calculateLWFDeduction(grossSalary, empType, data);
                                    lwfAmount[0] = deduction;
                                }
                            } else {
                                lwfAmount[0] = 0.0;
                            }
                        } else if (data.getFrequencyOfDeduction().equalsIgnoreCase("Yearly")) {
                            if (selectedMonth == 1) {
                                if (data.getPercentageOfSalary() == null || data.getPercentageOfSalary() == 0.0) {
                                    lwfAmount[0] = data.getEmployeeDeduction();
                                } else {

                                    double deduction = this.calculateLWFDeduction(grossSalary, empType, data);

                                    lwfAmount[0] = deduction;
                                }
                            } else {
                                lwfAmount[0] = 0.0;
                            }
                        }
                    }
                });
            }

        } catch (Exception e) {
            LOGGER.error("exception while calculateEmployeeProfessionalTax " + e.getMessage());
            e.printStackTrace();
        }

        return lwfAmount[0];
    }

    private double calculateLWFDeduction(double payableSalary, String empType, LabourLawDeduction data) {

        double deduction = 0.0;
        try {
            Double deductAmount = (payableSalary * data.getPercentageOfSalary()) / 100;

            if (deductAmount < data.getEmployeeDeduction()) {
                if (empType.equalsIgnoreCase("Worker")) {
                    deduction = (payableSalary * data.getPercentageOfSalary()) / 100;
                } else {
                    deduction = (payableSalary * data.getPercentageOfSalary()) / 100;
                }
                deduction = Math.round(deduction);

            } else {
                deduction = data.getEmployeeDeduction();
            }
            deduction = Math.round(deduction);
        } catch (Exception e) {
            e.printStackTrace();
        }
        return deduction;

    }

