    public Double getRateOfOvertimeOfFullTime(Long overTimeAllowanceTempleteId, List<Map> loopArrat) {

        Double rate = 0.0;

        List<Long> subIds = employeerepo.getSubMappingIdOfOverTime(overTimeAllowanceTempleteId);

        if (subIds.isEmpty()) {
            return rate;
        }
        Double ta = 0.0;
        for (int i = 0; i < loopArrat.size(); i++) {
            if (loopArrat.get(i).get("allowance_amount") != null) {

                if (subIds.contains(Long.parseLong(loopArrat.get(i).get("allowance_id").toString()))) {
                    ta += Double.parseDouble(loopArrat.get(i).get("allowance_amount").toString());
                }
            }
        }
        rate = ta / 30;
        rate = Math.round(rate * 100.0) / 100.0;

        return rate;
    }

