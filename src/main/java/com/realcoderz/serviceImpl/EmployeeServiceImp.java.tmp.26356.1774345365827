            resultMap.put("status", "exception");
            LOGGER.info("Problem in EmployeeServiceImpl -> updateAllowanceFAF() :: ", ex);
        }
        logger.info("result for updateAllowanceFAF " + resultMap.toString());
        return resultMap;

    }

