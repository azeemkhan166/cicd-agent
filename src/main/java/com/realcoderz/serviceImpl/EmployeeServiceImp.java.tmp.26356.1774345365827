        try {
            if (month == 1 || month == 2 || month == 3) {
                year = year - 1;
            }
            if (stateName != null && gender != null) {
                ProfessionalTaxNew proffTax = proffNewRepo.getProfessionalTax(month, stateName, grossSalary, gender, year);
                if (proffTax != null) {
                    if (proffTax.getFrequencyOfDeduction().equalsIgnoreCase("Monthly")) {
                        professnalTax = proffTax.getTaxAmount();
                    } else if (proffTax.getFrequencyOfDeduction().equalsIgnoreCase("Half yearly")) {
                        if (month == 6 || month == 12) {
                            professnalTax = proffTax.getTaxAmount();
                        }
                    } else if (proffTax.getFrequencyOfDeduction().equalsIgnoreCase("Quaterly")) {
                        if (month == 9 || month == 3 || month == 6 || month == 12) {
                            professnalTax = proffTax.getTaxAmount();
                        }
                    } else if (proffTax.getFrequencyOfDeduction().equalsIgnoreCase("Yearly")) {
