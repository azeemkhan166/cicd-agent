            // Assuming map.get("allowance") is a List<LinkedHashMap>
            List<LinkedHashMap<String, Object>> allowanceData = (List<LinkedHashMap<String, Object>>) map.get("allowance");

// Convert List<LinkedHashMap> to List<LinkedCaseInsensitiveMap>
            List<LinkedCaseInsensitiveMap> getSavedEployeeAllwance = allowanceData.stream()
                    .map(linkedHashMap -> {
                        LinkedCaseInsensitiveMap linkedCaseInsensitiveMap = new LinkedCaseInsensitiveMap();
                        linkedCaseInsensitiveMap.putAll(linkedHashMap);
                        return linkedCaseInsensitiveMap;
                    })
                    .collect(Collectors.toList());

            // Assuming map.get("deduction") is a List<LinkedHashMap>
            List<LinkedHashMap<String, Object>> deductionData = (List<LinkedHashMap<String, Object>>) map.get("deduction");

            // Convert List<LinkedHashMap> to List<LinkedCaseInsensitiveMap>
            List<LinkedCaseInsensitiveMap> getSavedEmployeeDeduction = deductionData.stream()
                    .map(linkedHashMap -> {
                        LinkedCaseInsensitiveMap linkedCaseInsensitiveMap = new LinkedCaseInsensitiveMap();
                        linkedCaseInsensitiveMap.putAll(linkedHashMap);
                        return linkedCaseInsensitiveMap;
                    })
                    .collect(Collectors.toList());

            Map otherEarningCalculations = (Map) map.get("otherEarning");
            LocalDate finalStartDate = LocalDate.parse(map.get("finalStartDate").toString());
            LocalDate endDate = LocalDate.parse(map.get("endDate").toString());

            getSavedEployeeAllwance.stream().forEach(key -> {
                if (key.get("allowance_name").toString().equalsIgnoreCase("total")) {
                    key.put("allowance_payable_amount", Math.round(SumOfAllowancePayableAmount[0]));
                } else {
                    double allowance_payable_amount = Math.round(Double.parseDouble(key.get("allowance_payable_amount").toString()));
                    SumOfAllowancePayableAmount[0] = SumOfAllowancePayableAmount[0] + allowance_payable_amount;
                    key.put("allowance_payable_amount", Math.round(allowance_payable_amount));
                }
            });

            // Assuming map.get("deduction") is a List<LinkedHashMap>
            List<LinkedHashMap<String, Object>> otherEarning = (List<LinkedHashMap<String, Object>>) otherEarningCalculations.get("otherEarningValue");

            // Convert List<LinkedHashMap> to List<LinkedCaseInsensitiveMap>
            List<LinkedCaseInsensitiveMap> otherEarn = otherEarning.stream()
                    .map(linkedHashMap -> {
                        LinkedCaseInsensitiveMap linkedCaseInsensitiveMap = new LinkedCaseInsensitiveMap();
                        linkedCaseInsensitiveMap.putAll(linkedHashMap);
                        return linkedCaseInsensitiveMap;
                    })
                    .collect(Collectors.toList());

            otherEarn.stream().forEach(key -> {
                if (key.get("name").toString().equalsIgnoreCase("total")) {
                    key.put("amount", Math.round(otherAllowance[0]));
                } else {

                    double allowance_payable_amount = Math.round(Double.parseDouble(key.get("amount").toString()));

                    if (key.get("name").toString().equalsIgnoreCase("incentives if any") || key.get("name").toString().equalsIgnoreCase("Others")) {
                        OtherForTax[0] = OtherForTax[0] + allowance_payable_amount;
                    }
                    otherAllowance[0] = otherAllowance[0] + allowance_payable_amount;
                    key.put("amount", Math.round(allowance_payable_amount));
                }
            });

            Map other = new HashMap<>();
            other.put("otherEarningValue", otherEarn);

            double[] TaxValue = new double[1];
            TaxValue[0] = 0.0;
            double[] hraValue = new double[1];
            hraValue[0] = 0.0;
            if (map.get("valueChangeFlag").toString().equalsIgnoreCase("yes")) {
                if (map.get("employeeType").toString().equalsIgnoreCase("full time") || map.get("employeeType").toString().equalsIgnoreCase("probation") || map.get("employeeType").toString().equalsIgnoreCase("permanent")) {
                    Map taxValue = this.TaxCalculationForFAF(Long.parseLong(map.get("employee_id").toString()), getSavedEployeeAllwance, endDate, finalStartDate, OtherForTax[0]);
                    TaxValue[0] = Double.parseDouble(taxValue.get("taxValue").toString());
                    hraValue[0] = Double.parseDouble(taxValue.get("hraValue").toString());

                    getSavedEmployeeDeduction.stream().forEach(key -> {
                        if (key.get("deduction_name").toString().equalsIgnoreCase("income tax")) {
                            key.put("deduction_payable_amount", Math.round(TaxValue[0]));
                        }
                    });

                }

            }
            getSavedEmployeeDeduction.stream().forEach(key -> {
                if (key.get("deduction_name").toString().equalsIgnoreCase("total deductions")) {
                    key.put("deduction_payable_amount", Math.round(SumOfDeduction[0]));
                } else {
                    double deduction_payable_amount = Math.round(Double.parseDouble(key.get("deduction_payable_amount").toString()));
                    SumOfDeduction[0] = SumOfDeduction[0] + deduction_payable_amount;
                    key.put("deduction_payable_amount", Math.round(deduction_payable_amount));

                }

            });

            Double NetPayable = (double) (SumOfAllowancePayableAmount[0] - SumOfDeduction[0] + otherAllowance[0]);
            double roundedValue = Math.round(NetPayable);
            resultMap.put("Allowance", getSavedEployeeAllwance);
            resultMap.put("Deduction", getSavedEmployeeDeduction);
            resultMap.put("OtherEarnig", other);
            resultMap.put("netPayable", Math.round(roundedValue));

