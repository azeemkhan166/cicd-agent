    @Override
    public Map findAll(HttpServletRequest request, String data) {
        LOGGER.info("In EmployeeServiceImpl -> findAll method started.");
        boolean salarybreak_SaveorNot = false;
        Map resultMap = new HashMap<>();
        try {
            Map map = mapper.readValue(EncryptDecryptUtils.decrypt(data), LinkedCaseInsensitiveMap.class);
            LOGGER.info("In EmployeeServiceImpl -> findAll method started Request Data :-" + map);
            String bearerToken = authenticationFilter.getJwtFromRequest(request);
            HttpHeaders header = new HttpHeaders();
            header.setBearerAuth(bearerToken);
            header.setContentType(MediaType.TEXT_PLAIN);
            HttpEntity<String> entity = new HttpEntity<>(data, header);
            Map restResp = restTemplate.exchange(reimburshment_url + "/users/getEmployeebyOrgId", HttpMethod.POST, entity, HashMap.class).getBody();
            LOGGER.info("In EmployeeServiceImpl -> findAll method started Timesheet Request Data :-" + restResp);
            Map datares = mapper.readValue(EncryptDecryptUtils.decrypt(restResp.get("data").toString()), LinkedCaseInsensitiveMap.class);
            LOGGER.info("In EmployeeServiceImpl -> findAll method started Timesheet Request Data :-" + datares);
            List<LinkedHashMap> empTime = (List<LinkedHashMap>) datares.get("list");
            LOGGER.info("In EmployeeServiceImpl -> findAll method started Timesheet List of Employee :-" + empTime);
            List<LinkedHashMap> employeeTypes = (List<LinkedHashMap>) datares.get("types");
            LOGGER.info("In EmployeeServiceImpl -> findAll method started Employee Type  :-" + employeeTypes);
            List<LinkedHashMap> employeeDepartments = (List<LinkedHashMap>) datares.get("departments");
            LOGGER.info("In EmployeeServiceImpl -> findAll method started Employee departments  :-" + employeeDepartments);
            if (map.get("month") != null && map.get("year") != null) {
                empTime.retainAll(this.filterEmpAsPerDate(empTime, Integer.parseInt((map.get("month")).toString()), Integer.parseInt((map.get("year")).toString())));
            }

            if (empTime != null && !empTime.isEmpty()) {
                int month = Integer.parseInt((map.get("month")).toString());
                List<LinkedCaseInsensitiveMap> salaryBraeakupSaveOrNot = salaryRepo.isSalaryBreapupExist(Long.parseLong(map.get("id").toString()), month, Integer.parseInt(map.get("year").toString()));
                LOGGER.info("In EmployeeServiceImpl -> findAll method started salaryBraeakupSaveOrNot of Employee :-" + salaryBraeakupSaveOrNot);
                List<LinkedCaseInsensitiveMap> account = employeerepo.accountExistByOrganizationId(Long.parseLong(map.get("id").toString()));
                LOGGER.info("In EmployeeServiceImpl -> findAll method started Employee account details by Org ID :-" + account);

                List<LinkedCaseInsensitiveMap> salaryDetails = employeerepo.findAllSalaryById(Long.parseLong(map.get("id").toString()));

                // SalatyBraeakup exit
                empTime.stream().forEach(emp -> {
                    if (!account.isEmpty()) {
                        account.stream().forEach(acc -> {
                            if (acc.get("employeeid") != null ? acc.get("employeeid").toString().equals(emp.get("employeeId").toString()) : false) {
                                emp.put("bankaccount", acc.get("bankaccount"));
                                emp.put("bankname", acc.get("bankname"));
                                emp.put("ifsc", acc.get("ifsc"));
                                emp.put("accexist", true);
                            }
                        });
                    }
                    List<LinkedCaseInsensitiveMap> salarys = salaryDetails.stream().filter(sal -> sal.get("employeeId").equals(emp.get("employeeId"))).collect(Collectors.toList());
                    if (!salarys.isEmpty()) {
                        Stream<LinkedCaseInsensitiveMap> optionalSalaryList;
                        Optional<LinkedCaseInsensitiveMap> optionalSalary = null;
                        try {
                            optionalSalaryList = salarys.stream().filter(sal -> (sal.get("month") != null && sal.get("year") != null) ? sal.get("month").toString().equals(map.get("month").toString()) && sal.get("year").toString().equals(map.get("year").toString()) : false);
                            optionalSalary = optionalSalaryList.count() > 0 ? optionalSalaryList.findFirst() : null;
                            optionalSalaryList.close();
                        } catch (Exception ex) {
                        }
                        if (optionalSalary != null ? optionalSalary.isPresent() : false) {
                            LinkedCaseInsensitiveMap salary = optionalSalary.get();
                            if (salary.get("effective_date") != null) {
                                Date effectiveDate = DateUtils.convertStringToDate(salary.get("effective_date").toString(), "yyyy-MM-dd");
                                Date currentDate = DateUtils.convertStringToDate(map.get("year").toString() + "-" + map.get("month").toString() + "-28", "yyyy-MM-dd");
                                if ((effectiveDate.equals(currentDate) || effectiveDate.before(currentDate)) && salary.get("appraisal_salary") != null) {
                                    Double appSalary = Double.parseDouble(salary.get("appraisal_salary").toString());
                                    emp.put("Gross", (appSalary > 0) ? appSalary : salary.get("gross_salary"));
                                } else {
                                    emp.put("Gross", salary.get("gross_salary"));
                                }
                            } else {
                                emp.put("Gross", salary.get("gross_salary"));
                            }
                        } else {
                            for (int i = 0; i < salarys.size(); i++) {
                                LinkedCaseInsensitiveMap salary = salarys.get(i);
                                if (salary.get("effective_date") != null) {
                                    Date effectiveDate = DateUtils.convertStringToDate(salary.get("effective_date").toString(), "yyyy-MM-dd");
                                    Date currentDate = DateUtils.convertStringToDate(map.get("year").toString() + "-" + map.get("month").toString() + "-28", "yyyy-MM-dd");
                                    if ((effectiveDate.equals(currentDate) || effectiveDate.before(currentDate)) && salary.get("appraisal_salary") != null) {
                                        Double appSalary = Double.parseDouble(salary.get("appraisal_salary").toString());
                                        emp.put("Gross", (appSalary > 0) ? appSalary : salary.get("gross_salary"));
                                        break;
                                    } else {
                                        emp.put("Gross", salary.get("gross_salary"));
                                    }
                                } else {
                                    emp.put("Gross", salary.get("gross_salary"));
                                }
                            }
                        }
                    }

                    if (!salaryBraeakupSaveOrNot.isEmpty()) {
                        salaryBraeakupSaveOrNot.stream().forEach(salary -> {
                            if (salary.get("employee_id") != null && emp.get("employeeId") != null) {
                                if ((salary.get("employee_id").toString()).equals(emp.get("employeeId").toString())) {
                                    emp.put("Gross", salary.get("gross_salary"));
                                    emp.put("net_amount", salary.get("net_amount"));
                                    emp.put("accexist_salaryBreakUp", true);
                                }
                            }
                        });
                    }
                });
                empTime.stream().forEach(emp1 -> {

                    if (!emp1.containsKey("accexist")) {
                        emp1.put("accexist", false);
                        emp1.put("editSalary_accexist", false);
                    }
                    //put all keys of account
                    if (!emp1.containsKey("accexist_salaryBreakUp")) {
                        emp1.put("net_amount", "");
                        emp1.put("accexist_salaryBreakUp", false);

                    }
                });
                resultMap.put("list", empTime);
                resultMap.put("status", "success");

            } else {
                resultMap.clear();
                resultMap.put("status", "error");
                resultMap.put("msg", "Employee details not found ");
            }
            resultMap.put("types", employeeTypes);
            resultMap.put("departments", employeeDepartments);
        } catch (Exception ex) {
            ex.printStackTrace();
            resultMap.clear();
            resultMap.put("status", "exception");
            LOGGER.info("Problem in EmployeeServiceImpl -> findAll() :: ", ex);
        }

        return resultMap;
    }

    public List<LinkedHashMap> filterEmpAsPerDate(List<LinkedHashMap> list, int month, int year) {
        List<LinkedHashMap> newList = new ArrayList<>();
        LocalDate localDate = LocalDate.of(year, month, salaryBreakupServiceImpl.getnumberOfDaysInMonth(month, year));
        ZoneId defaultZoneId = ZoneId.systemDefault();
        Date date = Date.from(localDate.atStartOfDay(defaultZoneId).toInstant());
        DateFormat format = new SimpleDateFormat("yyyy-MM-dd", Locale.ENGLISH);
        list.stream().forEach(l -> {
            Date date1;
            Date offBoardDate;
            try {
                if (l.get("joiningDate") != null) {
                    date1 = format.parse(l.get("joiningDate").toString());

                    if (date1.compareTo(date) < 0) {

                        if (l.get("offboardEndDate") != null) {
                            offBoardDate = format.parse(l.get("offboardEndDate").toString());

                            if (date.getMonth() == offBoardDate.getMonth() && date.getYear() == offBoardDate.getYear()) {
                                newList.add(l);

                            } else {

                                if (offBoardDate.compareTo(date) > 0) {
                                    newList.add(l);
                                }
                            }

                        } else {

                            newList.add(l);
                        }
                    }
                }
            } catch (ParseException ex) {
                ex.printStackTrace();
                LOGGER.error("Problem in EmployeeServiceImp :: filterEmpAsPerDate() => " + ex);
            }
        });
        return newList;
    }

    public List<LinkedHashMap> filterEmpAsPerType(List<LinkedHashMap> list, String type) {
        List<LinkedHashMap> newList = new ArrayList<>();
        for (LinkedHashMap l : list) {
            try {
                if (l.get("employeeType") != null) {
                    if (l.get("employeeType").toString().equals(type)) {
                        newList.add(l);
                    }
                }
            } catch (Exception ex) {
                LOGGER.error("Problem in EmployeeServiceImp :: filterEmpAsPerType() => " + ex);
            }
        }
        return newList;
    }

    public List<LinkedHashMap> filterEmpAsPerDepartment(List<LinkedHashMap> list, List<LinkedHashMap> listofDepartment, String department) {
        List<LinkedHashMap> newList = new ArrayList<>();
        listofDepartment.stream().forEach(l -> {
            try {
                if (l.get("department_name") != null) {
                    if (l.get("department_name").toString().equals(department)) {
                        list.stream().forEach(m -> {
                            if (Integer.parseInt(m.get("department_id").toString()) == Integer.parseInt(l.get("department_id").toString())) {
                                newList.add(m);
                            }
                        });
                    }
                }
            } catch (Exception ex) {
                LOGGER.error("Problem in EmployeeServiceImp :: filterEmpAsPerDepartment() => " + ex);
            }
        });
        return newList;
    }

