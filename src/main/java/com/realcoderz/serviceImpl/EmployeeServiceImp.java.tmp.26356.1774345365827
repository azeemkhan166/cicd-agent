                    if (map.get("bankname") != null && map.get("bankaccount") != null && map.get("ifsc") != null) {
                        employeerepo.updateAddress(map.get("bankname").toString(), map.get("bankaccount").toString(), map.get("ifsc").toString(), Long.parseLong(map.get("organization_id").toString()), Long.parseLong(map.get("employeeid").toString()));

                        // resultMap.put("msg", "update successfully");
