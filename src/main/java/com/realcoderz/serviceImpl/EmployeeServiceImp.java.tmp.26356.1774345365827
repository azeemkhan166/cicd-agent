    private void calculateEmployeeTotalsForVedant(LinkedCaseInsensitiveMap employee, String[] months, List<LinkedCaseInsensitiveMap>   payPlandata) {
        double totalDays = 0;
        double totalAmount = 0;

        // Calculate totals from monthly data
        for (String month : months) {
            String monthKey = month.replace("/", "_");

            Object payDaysObj = employee.get(monthKey + "_PayDays");
            Object amountObj = employee.get(monthKey + "_Amount");

            if (payDaysObj != null) {
                totalDays += getNumericValue(payDaysObj);
            }

            if (amountObj != null) {
                totalAmount += getNumericValue(amountObj);
            }
        }
        
        System.out.println("employee 12691");
        System.out.println(employee);
        
        Double[] percentage = new Double[1];
        percentage[0] = null;

        Double[] maximumValue = new Double[1];
        maximumValue[0] = null;
        
        Long payPlanId=Long.parseLong( employee.get("payPlanId").toString());
        
        payPlandata.stream().forEach(action -> {
            Long payId = Long.parseLong(action.get("id").toString());
            if (Objects.equals(payPlanId, payId)) {
                percentage[0] = action.get("percentage") != null ? Double.parseDouble(action.get("percentage").toString()) : 0;
                maximumValue[0] = action.get("maximumvalue") != null ? Double.parseDouble(action.get("maximumvalue").toString()) : 0;

            }

        });

        // Calculate bonus payable (8.33% of total amount)
        double bonusPayable = Math.ceil((totalAmount * percentage[0]) / 100);
        double bonusPayableBackup=bonusPayable;

        // Calculate ExGratia - if BonusPayable exceeds 21000, the exceeded amount goes to ExGratia
        double exGratia = 0.0;
        if (bonusPayable > maximumValue[0]) {
            bonusPayable=maximumValue[0];
            exGratia = bonusPayableBackup-maximumValue[0];
        }

        // Put the calculated values
        employee.put("TotalDays", Math.round(totalDays));
        employee.put("TotalAmount", Math.round(totalAmount));
        employee.put("BonusPayable", bonusPayable);
        employee.put("ExGratia", exGratia);
        employee.put("Remarks", "");
    }
    
