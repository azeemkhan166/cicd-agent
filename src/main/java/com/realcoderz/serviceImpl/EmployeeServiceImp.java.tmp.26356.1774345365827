                double currentAmount = Double.parseDouble(action.get("allowance_payable_amount").toString());

                double updatedAmount = (currentAmount / standardDays[0]) * actualWorkingDays[0];

                action.put("allowance_payable_amount", updatedAmount);

            });

            /**
             * Sum Of Allowance and Also Remove decimal value
