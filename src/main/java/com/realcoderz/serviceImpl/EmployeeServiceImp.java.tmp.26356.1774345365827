            SumOfDeduction[0] = 0.0;
            String numbertoword = "";

            // Calculate the number of year between the two dates
            long YearForLeaveEnhancement = ChronoUnit.YEARS.between(joiningDate, endDate.plusDays(1));

            double[] basicSalaryValue = new double[1];

            //   List<LinkedCaseInsensitiveMap> PayrollSavedValue= runPayrollRepo.getSavedRunPayrollBetweenMonth(Long.parseLong(map.get("employee_id").toString()),StartDate.getMonthValue(), endDate.getMonthValue(), StartDate.getYear(),endDate.getYear());
            // List<LinkedCaseInsensitiveMap> PayrollSavedValue= runPayrollRepo.getSavedRunPayrollBetweenMonth(Long.parseLong(map.get("employee_id").toString()),StartDate.toString(), endDate.toString());
            List<LinkedCaseInsensitiveMap> PayrollSavedValue = runPayrollRepo.getSavedRunPayrollBetweenMonth(Long.parseLong(map.get("employee_id").toString()), startMonth, Startyear, endMonth, endyear);

