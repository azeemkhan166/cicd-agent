                SumOfAllowanceAmount[0] = SumOfAllowanceAmount[0] + allowance_amount;
                SumOfAllowancePayableAmount[0] = SumOfAllowancePayableAmount[0] + allowance_payable_amount;

                key.put("allowance_amount", Math.round(allowance_amount));
                key.put("allowance_payable_amount", Math.round(allowance_payable_amount));

            });

            // adding total sum value in allowance
            LinkedCaseInsensitiveMap sumvalue = new LinkedCaseInsensitiveMap<>();
            sumvalue.put("allowance_name", "Total");
            sumvalue.put("allowance_amount", Math.round(SumOfAllowanceAmount[0]));
            sumvalue.put("allowance_payable_amount", Math.round(SumOfAllowancePayableAmount[0]));
            getSavedEployeeAllwance.add(sumvalue);

            /**
             * deduction calculation based on exact working day
             *
             */
            double monthValues = (actualWorkingDays[0] / 31.0);
            double[] monthValue = new double[1];
            monthValue[0] = 0.0;
            monthValue[0] = Math.ceil(monthValues);

            getSavedEmployeeDeduction.stream().forEach(action -> {
                if (!action.get("deduction_name").toString().equalsIgnoreCase("notice pay")) {

                    // working day calculation applicaple for deductio type variable
                    if (action.get("type_of_deduction").toString().equalsIgnoreCase("variable")) {
                        double currentAmount = Double.parseDouble(action.get("deduction_payable_amount").toString());
                        double updatedAmount = (currentAmount / standardDays[0]) * actualWorkingDays[0];
                        action.put("deduction_payable_amount", Math.round(updatedAmount));
                    } else {
                        if (!action.get("deduction_name").toString().equalsIgnoreCase("advance")) {
//                       if(monthValue == 0){
//                           double currentAmount = Double.parseDouble(action.get("deduction_payable_amount").toString());
//                           double updatedAmount = (currentAmount);
//                           action.put("deduction_payable_amount", Math.round(updatedAmount)); 
//                       }
//                       else{
                            double currentAmount = Double.parseDouble(action.get("deduction_payable_amount").toString());
                            double updatedAmount = (currentAmount * monthValue[0]);
                            action.put("deduction_payable_amount", Math.round(updatedAmount));
//                       }
                        }
                    }
                    // add remaining Loan Of Employee In Advance
                    if (action.get("deduction_name").toString().equalsIgnoreCase("advance")) {
                        action.put("deduction_payable_amount", Math.round(remiaingLoan[0]));
                    }
                }
            });

            Double otherValueForTax = 0.0;

            double[] TaxValue = new double[1];
            TaxValue[0] = 0.0;

            double[] hraValue = new double[1];
            hraValue[0] = 0.0;

            if (map.get("employeeType").toString().equalsIgnoreCase("full time") || map.get("employeeType").toString().equalsIgnoreCase("probation") || map.get("employeeType").toString().equalsIgnoreCase("permanent")) {
                Map taxValue = this.TaxCalculationForFAF(Long.parseLong(map.get("employee_id").toString()), getSavedEployeeAllwance, endDate, finalStartDate, otherValueForTax);
                TaxValue[0] = Double.parseDouble(taxValue.get("taxValue").toString());
                hraValue[0] = Double.parseDouble(taxValue.get("hraValue").toString());
            }

            /**
             * Sum Of Deduction and Also Remove decimal value
             *
             */
            getSavedEmployeeDeduction.stream().forEach(key -> {

                double deduction_payable_amount = Math.round(Double.parseDouble(key.get("deduction_payable_amount").toString()));
                if (key.get("deduction_name").toString().equalsIgnoreCase("income tax")) {

                    deduction_payable_amount = TaxValue[0];
                }
                SumOfDeduction[0] = SumOfDeduction[0] + deduction_payable_amount;
                key.put("deduction_payable_amount", Math.round(deduction_payable_amount));

            });

            LinkedCaseInsensitiveMap sumvaluefordeduction = new LinkedCaseInsensitiveMap<>();
            sumvaluefordeduction.put("deduction_name", "Total Deductions");
            sumvaluefordeduction.put("deduction_payable_amount", Math.round(SumOfDeduction[0]));
            getSavedEmployeeDeduction.add(sumvaluefordeduction);

            /**
             * other earning calculation
             *
             */
            String leaveEncasementKey = "";
            if (PayrollSettingValue.get("leave_encashment") != null && PayrollSettingValue.get("leave_encashment").toString().equalsIgnoreCase("gross salary")) {
                leaveEncasementKey = "Gross";
            } else {
                leaveEncasementKey = "Basic";
            }

            Map otherEarningCalculations = this.otherEarningCalculation(basicSalaryValue[0], Double.parseDouble(map.get("standard_gross_Salary").toString()), leaveEncasementKey, YearForLeaveEnhancement, leaveBalance, standardDays[0]);

            Double totalOtherEarning = Double.parseDouble(otherEarningCalculations.get("totalSumOFOtherEarning").toString());

            Double NetPayable = (double) (SumOfAllowancePayableAmount[0] - SumOfDeduction[0] + totalOtherEarning);
            double roundedValue = Math.round(NetPayable);

            /**
             * moving other deduction at second last index
             *
             *
             */
            String targetDeductionName = "Other Deductions";
            LinkedCaseInsensitiveMap otherDeductions = null;
            int indexToMove = -1;

            for (int i = 0; i < getSavedEmployeeDeduction.size(); i++) {

                LinkedCaseInsensitiveMap temp = getSavedEmployeeDeduction.get(i);
                if (targetDeductionName.equalsIgnoreCase((String) temp.get("deduction_name"))) {
                    otherDeductions = temp;
                    indexToMove = i;
                    break;
                }
            }
            if (indexToMove != -1) {

                getSavedEmployeeDeduction.remove(indexToMove);
                int secondToLastIndex = getSavedEmployeeDeduction.size() - 1;
                getSavedEmployeeDeduction.add(secondToLastIndex, otherDeductions);

            }

            /**
             * end here
             *
             */
            resultMap.put("Allowance", getSavedEployeeAllwance);
            resultMap.put("Deduction", getSavedEmployeeDeduction);
            resultMap.put("OtherEarnig", otherEarningCalculations);
            resultMap.put("OrganizationAddress", getOrganizationAddress);
            resultMap.put("EmployeeDetails", getEmployeeDetails);
            resultMap.put("netPayable", Math.round(roundedValue));

            numbertoword = NumberToWords.convertToWords(Double.toString(roundedValue));
            resultMap.put("AmountInWords", numbertoword);
            resultMap.put("totalDayInMonth", Math.round(standardDays[0]));
            resultMap.put("paidDays", actualWorkingDays[0]);
            resultMap.put("finalStartDate", finalStartDate);
            resultMap.put("endDate", endDate);
            resultMap.put("isFAFSaved", false);
            resultMap.put("currentDate", new Date());
            resultMap.put("hraAmount", Math.round(hraValue[0]));
            resultMap.put("status", "success");
        } catch (Exception ex) {

            ex.printStackTrace();
            resultMap.put("status", "exception");
            resultMap.put("msg", "Somethig went Worng");
        }

        return resultMap;

    }

    public Map TaxCalculationForFAF(Long employee_id, List<LinkedCaseInsensitiveMap> getSavedEployeeAllwance, LocalDate endDate, LocalDate finalStartDate, Double otherValueForTax) {

        Map result = new HashMap<>();
        int startYear = endDate.getYear();
        int endYear = endDate.getYear();
        int endDateMonth = endDate.getMonthValue();
        int startDateMonth = finalStartDate.getMonthValue();
        int startDateYear = finalStartDate.getYear();
        if (endDateMonth == 1 || endDateMonth == 2 || endDateMonth == 3) {

            startYear = startYear - 1;
        }
        if (startDateMonth == 1 || startDateMonth == 2 || startDateMonth == 3) {
            startDateYear = startDateYear - 1;
        }

        Map paidAllowances = taxserviceimple.alreadyPiadAllowances(employee_id, startYear, endYear);

        double hraSum = 0.0;

        Double basicSalary = getSavedEployeeAllwance.stream()
                .filter(allowance -> "Basic Salary".equalsIgnoreCase(allowance.get("allowance_name").toString()))
                .mapToDouble(allowance -> Double.parseDouble(allowance.get("allowance_payable_amount").toString()))
                .sum(); // Default value if not found

        Double hra = getSavedEployeeAllwance.stream()
                .filter(allowance -> "HRA".equalsIgnoreCase(allowance.get("allowance_name").toString()))
                .mapToDouble(allowance -> Double.parseDouble(allowance.get("allowance_payable_amount").toString()))
